{
  "background": [0, 0, 0, 127],
  "refreshMillis": 50,
  "alwaysOnTop": false,
  "hideCursor": false,
  "screen": 0,
  "layout": [
    {
      "type": "text",
      "text": "{time}",
      "anchor": "center",
      "y": -32,
      "timeFormat": "HH:mm:ss",
      "fontFamily": "Noto Sans",
      "fontSize": 256,
      "fontStyle": "plain",
      "color": [191, 191, 191, 255]
    },
    {
      "type": "text",
      "text": "{date}",
      "anchor": "center",
      "y": -160,
      "dateFormat": "MM/dd/yyyy",
      "fontFamily": "Noto Sans",
      "fontSize": 32,
      "fontStyle": "plain",
      "color": [191, 191, 191, 255]
    },
    {
      "type": "text",
      "text": "Hello, world!",
      "anchor": "center",
      "y": 128,
      "fontFamily": "Noto Sans",
      "fontSize": 32,
      "fontStyle": "plain",
      "color": [191, 191, 191, 255]
    }
  ]
}
